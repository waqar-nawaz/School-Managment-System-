# ==========================================================
# School Management System - root environment example
# Copy to .env before running docker-compose
# ==========================================================

# PostgreSQL (the only supported database)
POSTGRES_DB=school_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Backend
NODE_ENV=development
PORT=3000
JWT_SECRET=change_this_jwt_secret_in_production
JWT_REFRESH_SECRET=change_this_refresh_secret_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

DB_HOST=postgres
DB_PORT=5432

# CORS origin for the Angular frontend
CORS_ORIGIN=http://localhost

# Redis (optional - caching / rate limiting store)
REDIS_HOST=redis
REDIS_PORT=6379

# SMTP (email notifications)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@school.local

# SMS / Twilio (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Frontend URL (for emails / links)
FRONTEND_URL=http://localhost
# --- Added by the full review ---
# Password for the first super admin (admin@school.local). In production, if this is NOT set a random
# password is generated and logged ONCE at first boot. In development it defaults to Admin@123.
SEED_ADMIN_PASSWORD=
# Cron jobs (overdue invoices/books, fee reminders). On by default outside production;
# set RUN_JOBS=true on exactly ONE instance in production so reminders aren't duplicated.
RUN_JOBS=false
