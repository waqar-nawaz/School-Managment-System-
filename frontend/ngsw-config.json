{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.svg",
          "/favicon-32x32.png",
          "/index.html",
          "/manifest.webmanifest",
          "/icons/*.png",
          "/*.css",
          "/*.js"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/media/**",
          "/*.ico",
          "/*.svg"
        ]
      }
    }
  ],
  "dataGroups": [],
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/**/api/**",
    "!/**/auth/**",
    "!/**/ws/**",
    "!/**/uploads/**"
  ]
}
