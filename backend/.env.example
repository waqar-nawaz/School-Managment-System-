# Backend environment (see root .env.example for docker usage)
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=school_db
DB_USER=school_user
DB_PASS=school_pass

# JWT
JWT_SECRET=local_dev_jwt_secret_change_me
JWT_REFRESH_SECRET=local_dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limiting (per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@school.local

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FRONTEND_URL=http://localhost:4200

# Seed default data on boot
RUN_SEEDERS=true

# Upload directory (relative to backend root)
UPLOAD_DIR=uploads