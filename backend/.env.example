# Backend environment (see root .env.example for docker usage)
NODE_ENV=development
PORT=3000

# Database (postgres is the default; set DB_DIALECT=mysql for MySQL)
DB_DIALECT=postgres
DB_HOST=localhost
DB_PORT=5432
DB_NAME=school_db
DB_USER=postgres
DB_PASS=postgres
# Or provide a single connection string (takes precedence over DB_* above)
# DATABASE_URL=postgres://user:pass@host:5432/school_db
# Set to "true" when the provider requires SSL (e.g. external/managed DB)
DB_SSL=false

# JWT
JWT_SECRET=local_dev_jwt_secret_change_me
JWT_REFRESH_SECRET=local_dev_refresh_secret_change_me
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:4200

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Rate limiting (per minute per IP)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@school.local

# SMS (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

FRONTEND_URL=http://localhost:4200

# Seed default data on boot
RUN_SEEDERS=true

# Upload directory (relative to backend root)
UPLOAD_DIR=uploads